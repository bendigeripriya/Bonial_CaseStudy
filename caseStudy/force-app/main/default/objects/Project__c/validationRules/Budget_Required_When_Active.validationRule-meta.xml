<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Budget_Required_When_Active</fullName>
    <active>true</active>
    <description>When the project Status is Active, Budget must be greater than 0.</description>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &quot;Active&quot;),
    OR(
        ISBLANK(Budget__c),
        Budget__c &lt;= 0
    )
)</errorConditionFormula>
    <errorDisplayField>Budget__c</errorDisplayField>
    <errorMessage>Budget must be greater than 0 when Status is Active.</errorMessage>
</ValidationRule>
